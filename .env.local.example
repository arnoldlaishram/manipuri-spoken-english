# Copy this file to .env.local and put your key in it.
#   cp .env.local.example .env.local
#
# The key is read ONLY on the server (app/api/claude/route.ts).
# It is never sent to the browser.
ANTHROPIC_API_KEY=sk-ant-...

# Optional. Only for pronunciation feedback on her recordings — Claude cannot
# take audio, so this one job uses Gemini. Everything else works without it.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest   # GET /api/speech lists what your key has
